+func TestServiceUpdate(t *testing.T) {
+	created := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	updated := time.Date(2026, 2, 2, 0, 0, 0, 0, time.UTC)
+
+	t.Run("updates text and touches UpdatedAt", func(t *testing.T) {
+		repo := newFakeRepo()
+		svc := NewService(repo, fixedID{id: "abc"}, fixedClock{t: updated})
+		repo.notes["abc"] = Note{ID: "abc", Text: "old", CreatedAt: created, UpdatedAt: created}
+
+		got, err := svc.Update(context.Background(), "abc", "  new  ")
+		if err != nil {
+			t.Fatalf("Update() err = %v, want nil", err)
+		}
+		if got.Text != "new" {
+			t.Errorf("Text = %q, want %q", got.Text, "new")
+		}
+		if !got.CreatedAt.Equal(created) {
+			t.Errorf("CreatedAt = %v, want %v (must not change)", got.CreatedAt, created)
+		}
+		if !got.UpdatedAt.Equal(updated) {
+			t.Errorf("UpdatedAt = %v, want %v", got.UpdatedAt, updated)
+		}
+	})
+
+	t.Run("empty text is rejected", func(t *testing.T) {
+		repo := newFakeRepo()
+		svc := NewService(repo, fixedID{id: "abc"}, fixedClock{t: updated})
+		repo.notes["abc"] = Note{ID: "abc", Text: "old", CreatedAt: created, UpdatedAt: created}
+
+		if _, err := svc.Update(context.Background(), "abc", "   "); !errors.Is(err, ErrEmptyText) {
+			t.Fatalf("Update() err = %v, want %v", err, ErrEmptyText)
+		}
+	})
+
+	t.Run("missing note returns ErrNotFound", func(t *testing.T) {
+		svc := NewService(newFakeRepo(), fixedID{id: "abc"}, fixedClock{t: updated})
+
+		if _, err := svc.Update(context.Background(), "missing", "text"); !errors.Is(err, ErrNotFound) {
+			t.Fatalf("Update() err = %v, want %v", err, ErrNotFound)
+		}
+	})
+}
