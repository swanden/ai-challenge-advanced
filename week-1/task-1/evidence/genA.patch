+// Update заменяет текст существующей заметки и обновляет метку времени.
+// Возвращает ErrEmptyText при пустом тексте и ErrNotFound, если заметки нет.
+func (s *Service) Update(ctx context.Context, id, text string) (Note, error) {
+	text = strings.TrimSpace(text)
+	if text == "" {
+		return Note{}, ErrEmptyText
+	}
+
+	n, err := s.repo.Get(ctx, id)
+	if err != nil {
+		return Note{}, err
+	}
+
+	n.Text = text
+	n.UpdatedAt = s.clock.Now()
+	if err := s.repo.Update(ctx, n); err != nil {
+		return Note{}, err
+	}
+	return n, nil
+}
+
